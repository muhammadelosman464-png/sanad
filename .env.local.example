# ════════════════════════════════════════════════════════
# SANAD — .env.local.example
# ════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to source control.

# ── Supabase (REQUIRED for Auth + Database) ──────────────
# 1. Go to https://supabase.com/dashboard
# 2. Open your project → Settings → API
# 3. Copy "Project URL" and "anon public" key below
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only admin key (bypasses RLS) — NEVER use NEXT_PUBLIC_ prefix
# Found at: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Lemon Squeezy (Payments) ─────────────────────────────
LEMONSQUEEZY_API_KEY=your_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
NEXT_PUBLIC_LEMONSQUEEZY_AFFILIATE_URL=https://sanad.lemonsqueezy.com/buy/demo

# ── Chatbot / Integrations ───────────────────────────────
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/sanad-bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=SanadSupportBot

# Admin email (only this user sees Admin Panel button)
NEXT_PUBLIC_ADMIN_EMAIL=your-admin-email@gmail.com
